# vulture-gateway 部署所需的敏感/覆盖项（复制为 .env 后填值；.env 不入库）。
# dev 配置的其余默认值已对齐单机拓扑（issuer/litellm 均 127.0.0.1、redis addr 127.0.0.1:6379）。

# 上游 Casdoor 切真实 OIDC（dev 默认 stub）
VG_OAUTH_UPSTREAM_MODE=oidc
# Casdoor app-built-in 的 client_secret（存于 Casdoor application 表，勿外泄）
VG_OAUTH_UPSTREAM_CLIENT_SECRET=__FILL_ME__
# 网关 access JWT 签名密钥（HS256），生产用强随机：openssl rand -hex 32
VG_JWT_SECRET=__FILL_ME__

# 数据层复用 litellm 栈共享实例（公共基础设施）：
# postgres → litellm-db（127.0.0.1:5432），库 vulture_gateway + 独立用户 vulture
VG_POSTGRES_DSN=host=127.0.0.1 user=vulture password=__FILL_ME__ dbname=vulture_gateway port=5432 sslmode=disable
# redis → litellm-redis（127.0.0.1:6379），用 db1 与 litellm 的 db0 隔离
VG_REDIS_DB=1
